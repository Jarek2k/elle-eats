    "db:reset": "rm -rf data && node --env-file=.env src/seed.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "arctic": "^2.3.4",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.13"
  }
}
